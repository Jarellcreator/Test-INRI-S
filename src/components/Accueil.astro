---
/**
 * Contenu de la page d'accueil, partagé par les deux déclinaisons
 * (/ en sombre, /clair/ en clair). Écrit une seule fois.
 */
import { formations } from '../data/formations.js';
import CarteFormation from './CarteFormation.astro';
---

<!-- ====================== HERO ====================== -->
  <section class="hero">
    <div class="wrap">
      <div class="hero__grid">

        <div class="hero__copy">
          <span class="eyebrow">Certifié Qualiopi · Finançable CPF</span>

          <h1 class="h1">
            Votre permis<br>
            en <em class="grad-text">1 à 4 semaines</em>
          </h1>

          <p class="lead">
            Depuis 2003, INRI'S Formations est le premier réseau français spécialisé
            dans les stages de permis accélérés. Un apprentissage personnalisé,
            un accompagnement de bout en bout, et plus de 300 lieux de conduite partout en France.
          </p>

          <div class="hero__actions">
            <a class="btn btn--primary" href="#contact">
              Démarrer ma formation
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a class="btn btn--ghost" href="#formations">Découvrir les formations</a>
          </div>

          <ul class="hero__trust">
            <li class="chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5"/></svg>
              Organisme certifié Qualiopi
            </li>
            <li class="chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5"/></svg>
              Jusqu'à 100 % financé par le CPF
            </li>
            <li class="chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5"/></svg>
              Réseau national
            </li>
          </ul>
        </div>

        <div class="hero__visual">
          <div class="floating floating--tl">
            <span class="floating__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 3 7v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V7Z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <span>
              <span class="floating__k">Qualiopi</span>
              <span class="floating__s">Formation certifiée</span>
            </span>
          </div>

          <div class="pathcard">
            <div class="pathcard__head">
              <div>
                <div class="pathcard__title">Permis B — Formule accélérée</div>
                <div class="pathcard__meta">Parcours type · 3 semaines</div>
              </div>
              <span class="pathcard__badge">Places ouvertes</span>
            </div>

            <ol class="steps">
              <li class="step is-done">
                <span class="step__num">1</span>
                <span>
                  <span class="step__label">Évaluation de départ</span>
                  <span class="step__sub">Bilan de conduite offert</span>
                </span>
                <span class="step__state">Validé</span>
              </li>
              <li class="step is-done">
                <span class="step__num">2</span>
                <span>
                  <span class="step__label">Code en immersion</span>
                  <span class="step__sub">Sessions intensives encadrées</span>
                </span>
                <span class="step__state">Validé</span>
              </li>
              <li class="step is-done">
                <span class="step__num">3</span>
                <span>
                  <span class="step__label">Conduite intensive</span>
                  <span class="step__sub">Moniteur dédié, véhicule fourni</span>
                </span>
                <span class="step__state">En cours</span>
              </li>
              <li class="step">
                <span class="step__num">4</span>
                <span>
                  <span class="step__label">Passage de l'examen</span>
                  <span class="step__sub">Date réservée à l'avance</span>
                </span>
                <span class="step__state">À venir</span>
              </li>
            </ol>

            <div class="pathcard__foot">
              <div class="progress"><div class="progress__bar" data-progress="72"></div></div>
              <span class="progress__val">72 %</span>
            </div>
          </div>

          <div class="floating floating--br">
            <span class="floating__icon floating__icon--mint">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            </span>
            <span>
              <span class="floating__k">1 à 4 semaines</span>
              <span class="floating__s">Durée moyenne du stage</span>
            </span>
          </div>
        </div>

      </div>
    </div>
  </section>

<!-- ====================== BANDEAU DE CONFIANCE ====================== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 3 7v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V7Z"/></svg> Certification Qualiopi</span>
      <span class="marquee__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg> Financement CPF</span>
      <span class="marquee__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/></svg> Réseau national</span>
      <span class="marquee__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/></svg> Permis B · Moto · Poids lourd · Bateau</span>
      <span class="marquee__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Depuis 2003</span>
      <span class="marquee__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 3 7v6c0 5 3.8 8.7 9 10 5.2-1.3 9-5 9-10V7Z"/></svg> Certification Qualiopi</span>
      <span class="marquee__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg> Financement CPF</span>
      <span class="marquee__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/></svg> Réseau national</span>
      <span class="marquee__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/></svg> Permis B · Moto · Poids lourd · Bateau</span>
      <span class="marquee__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Depuis 2003</span>
    </div>
  </div>

<!-- ====================== CHIFFRES CLÉS ====================== -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="stats reveal">
        <div class="stat">
          <div class="stat__num"><span data-count="20">0</span>+</div>
          <div class="stat__label">années d'expérience<br>depuis 2003</div>
        </div>
        <div class="stat">
          <div class="stat__num"><span data-count="300">0</span>+</div>
          <div class="stat__label">lieux de conduite<br>partout en France</div>
        </div>
        <div class="stat">
          <div class="stat__num"><span data-count="1">0</span>–<span data-count="4">0</span></div>
          <div class="stat__label">semaines pour obtenir<br>le permis B</div>
        </div>
        <div class="stat">
          <div class="stat__num"><span data-count="100">0</span>&nbsp;%</div>
          <div class="stat__label">finançable via<br>votre compte CPF</div>
        </div>
      </div>
    </div>
  </section>

<!-- ====================== FORMATIONS ====================== -->
  <section class="section" id="formations">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Nos formations</span>
        <h2 class="h2">Une formule accélérée<br>pour <span class="grad-text">chaque permis</span></h2>
        <p class="lead">
          Auto, moto, poids lourd, bateau ou récupération de points : chaque parcours
          est construit autour de votre niveau initial et de vos disponibilités.
        </p>
      </div>

      <div class="cards">
        {formations.map((f) => <CarteFormation formation={f} />)}
      </div>
    </div>
  </section>

<!-- ====================== MÉTHODE ====================== -->
  <section class="section" id="methode">
    <div class="wrap">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">La méthode INRI'S</span>
        <h2 class="h2">Quatre étapes,<br><span class="grad-text">zéro temps mort</span></h2>
        <p class="lead" style="margin-inline:auto">
          Le problème que nous résolvons depuis 2003 : des formations au permis
          beaucoup trop longues. Notre réponse tient en un parcours resserré et cadré.
        </p>
      </div>

      <div class="method">
        <article class="method__item reveal">
          <span class="method__num">ÉTAPE 01</span>
          <h3>Évaluation de départ</h3>
          <p>Un bilan de votre niveau réel définit le volume d'heures et la durée du stage. Pas de forfait standard imposé.</p>
        </article>
        <article class="method__item reveal">
          <span class="method__num">ÉTAPE 02</span>
          <h3>Code en immersion</h3>
          <p>Sessions intensives encadrées par un formateur, plutôt que des heures de révision solitaire étalées sur des mois.</p>
        </article>
        <article class="method__item reveal">
          <span class="method__num">ÉTAPE 03</span>
          <h3>Conduite intensive</h3>
          <p>Plusieurs heures par jour avec un moniteur dédié : les acquis s'installent sans être perdus entre deux leçons.</p>
        </article>
        <article class="method__item reveal">
          <span class="method__num">ÉTAPE 04</span>
          <h3>Examen &amp; réussite</h3>
          <p>La date d'examen est calée dès l'inscription. Vous arrivez le jour J au sommet de votre préparation.</p>
        </article>
      </div>
    </div>
  </section>

<!-- ====================== FINANCEMENT ====================== -->
  <section class="section" id="financement">
    <div class="wrap">
      <div class="split">

        <div class="reveal">
          <span class="eyebrow">Financement</span>
          <h2 class="h2">Votre permis financé<br>jusqu'à <span class="mint">100 %</span></h2>
          <p class="lead">
            INRI'S Formations est un organisme certifié Qualiopi : votre formation est
            éligible au Compte Personnel de Formation. Nous vous accompagnons dans
            toutes les démarches, du dossier au premier cours.
          </p>

          <ul class="checklist">
            <li>
              <span class="checklist__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5"/></svg></span>
              <span><strong>Certification Qualiopi</strong> — gage d'une formation conforme et de qualité, exigée pour tout financement public.</span>
            </li>
            <li>
              <span class="checklist__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5"/></svg></span>
              <span><strong>Mobilisation de votre CPF</strong> — jusqu'à 100 % du coût de la formation pris en charge selon vos droits acquis.</span>
            </li>
            <li>
              <span class="checklist__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5"/></svg></span>
              <span><strong>Dossier accompagné</strong> — un conseiller vérifie votre éligibilité et monte le dossier avec vous.</span>
            </li>
            <li>
              <span class="checklist__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5"/></svg></span>
              <span><strong>Aucune avance de frais</strong> sur la part financée : vous ne réglez que l'éventuel reste à charge.</span>
            </li>
          </ul>
        </div>

        <aside class="panel reveal">
          <span class="eyebrow" style="margin-bottom:16px">Simulation express</span>
          <h3 class="h3">Estimez votre reste à charge</h3>
          <div class="price">
            <span class="price__v grad-text">0 €</span>
            <span class="price__u">de reste à charge possible</span>
          </div>
          <p style="color:var(--text-3);font-size:14.5px">
            Si vos droits CPF couvrent le montant de la formation choisie.
          </p>

          <div class="panel__divider"></div>

          <div class="mini"><span>Durée du stage</span><span>1 à 4 semaines</span></div>
          <div class="mini"><span>Date d'examen</span><span>Réservée à l'inscription</span></div>
          <div class="mini"><span>Lieux de conduite</span><span>300+ en France</span></div>
          <div class="mini"><span>Réponse conseiller</span><span class="mint">Sous 24 h ouvrées</span></div>

          <a class="btn btn--primary btn--block" href="#contact" style="margin-top:30px">
            Vérifier mon éligibilité CPF
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </aside>

      </div>
    </div>
  </section>

<!-- ====================== AVIS ======================
       TODO : remplacer ces trois témoignages par de vrais avis clients
       (Google, Trustpilot…) avant toute mise en ligne publique.        -->
  <section class="section" id="avis">
    <div class="wrap">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Ils l'ont fait avec nous</span>
        <h2 class="h2">Des parcours<br><span class="grad-text">qui vont vite</span></h2>
      </div>

      <div class="quotes">
        <article class="quote reveal">
          <div class="stars" aria-label="Note de 5 sur 5">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
          </div>
          <p>« Témoignage à remplacer. Décrivez ici l'expérience d'un élève : sa situation de départ, le déroulé du stage et le résultat obtenu. »</p>
          <div class="quote__author">
            <span class="avatar" aria-hidden="true">AB</span>
            <span>
              <span class="quote__name">Prénom N.</span>
              <span class="quote__meta">Permis B accéléré · Ville</span>
            </span>
          </div>
        </article>

        <article class="quote reveal">
          <div class="stars" aria-label="Note de 5 sur 5">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
          </div>
          <p>« Témoignage à remplacer. Mettez en avant un point différenciant : la rapidité, l'accompagnement du conseiller ou la prise en charge CPF. »</p>
          <div class="quote__author">
            <span class="avatar" aria-hidden="true">CD</span>
            <span>
              <span class="quote__name">Prénom N.</span>
              <span class="quote__meta">Permis moto A2 · Ville</span>
            </span>
          </div>
        </article>

        <article class="quote reveal">
          <div class="stars" aria-label="Note de 5 sur 5">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1Z"/></svg>
          </div>
          <p>« Témoignage à remplacer. Un avis court et concret fonctionne mieux qu'un paragraphe générique : citez une durée, un lieu, un résultat. »</p>
          <div class="quote__author">
            <span class="avatar" aria-hidden="true">EF</span>
            <span>
              <span class="quote__name">Prénom N.</span>
              <span class="quote__meta">Groupe lourd · Ville</span>
            </span>
          </div>
        </article>
      </div>
    </div>
  </section>

<!-- ====================== FAQ ====================== -->
  <section class="section" id="faq">
    <div class="wrap">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Questions fréquentes</span>
        <h2 class="h2">Tout ce qu'il faut savoir<br>avant de <span class="grad-text">se lancer</span></h2>
      </div>

      <div class="faq">

        <div class="acc reveal">
          <h3>
            <button class="acc__btn" type="button" aria-expanded="false" aria-controls="faq-1">
              Combien de temps faut-il réellement pour obtenir le permis B ?
              <span class="acc__sign" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
            </button>
          </h3>
          <div class="acc__panel" id="faq-1" role="region">
            <div class="acc__inner">
              <p>Avec la formule accélérée, le permis B s'obtient généralement en 1 à 4 semaines. La durée exacte dépend de deux facteurs : vos disponibilités et votre niveau initial, mesuré lors de l'évaluation de départ.</p>
            </div>
          </div>
        </div>

        <div class="acc reveal">
          <h3>
            <button class="acc__btn" type="button" aria-expanded="false" aria-controls="faq-2">
              Puis-je financer ma formation avec mon CPF ?
              <span class="acc__sign" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
            </button>
          </h3>
          <div class="acc__panel" id="faq-2" role="region">
            <div class="acc__inner">
              <p>Oui. INRI'S Formations étant certifié Qualiopi, vous pouvez financer jusqu'à 100 % de votre permis via votre Compte Personnel de Formation, dans la limite des droits que vous avez acquis. Un conseiller vérifie votre éligibilité et vous accompagne dans le montage du dossier.</p>
            </div>
          </div>
        </div>

        <div class="acc reveal">
          <h3>
            <button class="acc__btn" type="button" aria-expanded="false" aria-controls="faq-3">
              Que signifie la certification Qualiopi ?
              <span class="acc__sign" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
            </button>
          </h3>
          <div class="acc__panel" id="faq-3" role="region">
            <div class="acc__inner">
              <p>Qualiopi est la marque de certification nationale des organismes de formation. Elle atteste que la formation dispensée est conforme à un référentiel qualité exigeant — et elle conditionne l'accès aux financements publics et mutualisés, dont le CPF.</p>
            </div>
          </div>
        </div>

        <div class="acc reveal">
          <h3>
            <button class="acc__btn" type="button" aria-expanded="false" aria-controls="faq-4">
              Où se déroulent les formations ?
              <span class="acc__sign" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
            </button>
