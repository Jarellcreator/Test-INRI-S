---
/**
 * Pied de page — écrit UNE SEULE FOIS.
 * La liste des formations est lue depuis src/data/formations.js : ajouter une
 * formation la fait apparaître ici sans toucher à ce fichier.
 */
import { formations } from '../data/formations.js';

const { theme = 'sombre', racine = '' } = Astro.props;
const logo = theme === 'clair' ? 'logo-inris.svg' : 'logo-inris-blanc.svg';

// Bascule entre les deux déclinaisons, le temps de choisir laquelle garder.
const bascule = theme === 'clair'
  ? { href: '/', libelle: 'Voir la version sombre' }
  : { href: '/clair/', libelle: 'Voir la version claire' };

const reseaux = [
  { nom: 'Facebook', d: '<path d="M14 9h3V6h-3a4 4 0 0 0-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2a1 1 0 0 1 1-1Z"/>', plein: true },
  { nom: 'Instagram', d: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>', plein: false },
  { nom: 'LinkedIn', d: '<path d="M4.5 3.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3 9h3v12H3V9Zm6 0h3v1.7A3.5 3.5 0 0 1 15 9c2.6 0 4 1.7 4 4.6V21h-3v-6.7c0-1.6-.6-2.5-2-2.5s-2 .9-2 2.5V21H9V9Z"/>', plein: true },
  { nom: 'TikTok', d: '<path d="M16.6 2H13.5v13.3a2.55 2.55 0 1 1-2.1-2.5V9.7a5.85 5.85 0 1 0 5.2 5.8V9.2a6.9 6.9 0 0 0 4 1.28V7.35A3.87 3.87 0 0 1 16.6 3.5V2Z"/>', plein: true },
  { nom: 'YouTube', d: '<path d="M22 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.8-1.8C18.3 5 12 5 12 5s-6.3 0-7.8.5a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.8 1.8C5.7 19 12 19 12 19s6.3 0 7.8-.5a2.5 2.5 0 0 0 1.8-1.8C22 15.2 22 12 22 12ZM10 15V9l5 3-5 3Z"/>', plein: true },
];

const annee = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">

      <div>
        <a class="logo logo--lg" href={racine || '#top'}>
          <img class="logo__img" src={`/assets/img/${logo}`} alt="INRI'S Formations — retour à l'accueil" width="130" height="59" />
        </a>
        <p>
          Premier réseau français spécialisé dans les stages de permis accélérés
          depuis 2003. Organisme de formation certifié Qualiopi.
        </p>
        <div class="socials">
          {reseaux.map((r) => (
            <a href="#" aria-label={`INRI'S Formations sur ${r.nom}`}>
              <svg viewBox="0 0 24 24" fill={r.plein ? 'currentColor' : 'none'} stroke={r.plein ? undefined : 'currentColor'} stroke-width={r.plein ? undefined : '2'} aria-hidden="true" set:html={r.d} />
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="font-title">Formations</h4>
        <ul class="footer__list">
          {formations.map((f) => (
            <li><a href={`/formations/${f.slug}/${f.ancre ?? ''}`}>{f.titreCourt}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-title">Le réseau</h4>
        <ul class="footer__list">
          <li><a href={`${racine}#methode`}>Qui sommes-nous</a></li>
          <li><a href={`${racine}#methode`}>Notre méthode</a></li>
          <li><a href={`${racine}#financement`}>Certification Qualiopi</a></li>
          <li><a href={`${racine}#avis`}>Avis des élèves</a></li>
          <li><a href={`${racine}#contact`}>Nos centres</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-title">Contact</h4>
        <ul class="footer__list">
          <li><a href="tel:+33000000000">01 00 00 00 00</a></li>
          <li><a href="mailto:contact@inris-formations.com">contact@inris-formations.com</a></li>
          <li><a href={`${racine}#faq`}>Questions fréquentes</a></li>
          <li><a href={`${racine}#contact`}>Demander un devis</a></li>
        </ul>
      </div>

    </div>

    <div class="footer__bottom">
      <span>© {annee} INRI'S Formations. Tous droits réservés.</span>
      <a class="theme-switch" href={bascule.href}>
        {theme === 'clair' ? (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        ) : (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        )}
        {bascule.libelle}
      </a>
      <nav class="footer__legal" aria-label="Liens légaux">
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/confidentialite/">Politique de confidentialité</a>
        <a href="/cgv/">CGV</a>
        <a href="/accessibilite/">Accessibilité</a>
      </nav>
    </div>
  </div>
</footer>
